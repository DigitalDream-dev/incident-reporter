# Copy to .env and adjust. Loaded by the CLI, LangGraph dev (`langgraph.json` env: ".env"), and tests.

# ============================================
# Notion (workflow input + tools)
# ============================================

# Notion page id for the incident. Used when graph input omits notionPageId (e.g. LangGraph dev) or CLI without --page-id.
# Example: 2fc4a8f9b3bc4b8f9c0d1e2f3a4b5c6d
NOTION_PAGE_ID=
# Internal integration secret from https://www.notion.so/profile/integrations (starts with ntn_ or secret_).
# Grant the integration access to your incident page (page ••• → Connect to integrations, or Integration → Access).
# Used for REST prefetch in extract() and passed to @notionhq/notion-mcp-server as NOTION_TOKEN (that server does not use NOTION_API_KEY).
NOTION_TOKEN=
# Optional. Override the Notion API host (default https://api.notion.com). Use for proxies or compatible endpoints.
NOTION_BASE_URL=
# Optional: override the default mock page id when USE_MOCK_NOTION=true and NOTION_PAGE_ID is unset.
# MOCK_NOTION_PAGE_ID=00000000-0000-4000-8000-000000000001

# If true, use in-process mock Notion tools (no MCP, no real Notion). Default on so CLI runs without secrets.
# If false, set NOTION_TOKEN or NOTION_API_KEY — the app spawns @notionhq/notion-mcp-server over stdio.
USE_MOCK_NOTION=true

# Optional alias: if set without NOTION_TOKEN, this value is used for MCP + REST the same way.
# NOTION_API_KEY=

# ============================================
# Azure DevOps (MCP only — post-extract node)
# ============================================

# If true, stub ADO tools (no subprocess). Default on for local runs without org secrets.
USE_MOCK_AZURE_DEVOPS=true

# Required when USE_MOCK_AZURE_DEVOPS=false. Example: https://dev.azure.com/yourorg
AZURE_DEVOPS_ORG_URL=

# pat (default if unset) | azure-cli | azure-identity — see mcp-server-azure-devops docs.
AZURE_DEVOPS_AUTH_METHOD=pat

# Required when AUTH_METHOD is pat (default).
AZURE_DEVOPS_PAT=

# Optional default project for searches.
AZURE_DEVOPS_DEFAULT_PROJECT=

# When searching for related incidents, restrict to this tag (default pending).
# INCIDENT_PENDING_TAG=pending

# ============================================
# LLM (inspector.config.json in this directory, optionally INSPECTOR_CONFIG_PATH)
# ============================================

# If inspector.config.json is not in the process cwd (e.g. some deploys).
# INSPECTOR_CONFIG_PATH=

# --- When providerMode is copilot-extension: OpenAI-compatible API (Copilot proxy, LiteLLM, etc.)
OPENAI_BASE_URL=http://127.0.0.1:3030/v1
OPENAI_API_KEY=

# --- Optional: createClaudeModel() / Anthropic-only scripts (not used by resolveAgentChatModel)
# CLAUDE_TRANSPORT=api
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ============================================
# LangSmith (LangGraph dev / traces)
# ============================================

# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=incident-reporter
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com