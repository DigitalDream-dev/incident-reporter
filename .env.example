# Copy to .env and adjust. Loaded by the CLI, LangGraph dev (`langgraph.json` env: ".env"), and tests.

# ============================================
# Notion (workflow input + tools)
# ============================================

# Notion page id for the incident. Used when graph input omits notionPageId (e.g. LangGraph dev) or CLI without --page-id.
# Example: 2fc4a8f9b3bc4b8f9c0d1e2f3a4b5c6d
NOTION_PAGE_ID=
# Integration token (internal integration) — enables direct Notion REST fetch in the extract step (see NOTION_BASE_URL).
NOTION_TOKEN=
# Optional. Override the Notion API host (default https://api.notion.com). Use for proxies or compatible endpoints.
NOTION_BASE_URL=
# Optional: override the default mock page id when USE_MOCK_NOTION=true and NOTION_PAGE_ID is unset.
# MOCK_NOTION_PAGE_ID=00000000-0000-4000-8000-000000000001

# If true, use in-process mock Notion tools (no MCP, no real Notion). Default on so CLI runs without secrets.
# If false, set NOTION_TOKEN or NOTION_API_KEY — the app spawns @notionhq/notion-mcp-server over stdio.
USE_MOCK_NOTION=true

# Used by the Notion MCP subprocess when USE_MOCK_NOTION=false. If unset, NOTION_TOKEN is reused.
# NOTION_API_KEY=

# ============================================
# LLM (inspector.config.json in this directory, optionally INSPECTOR_CONFIG_PATH)
# ============================================

# If inspector.config.json is not in the process cwd (e.g. some deploys).
# INSPECTOR_CONFIG_PATH=

# --- When providerMode is copilot-extension: OpenAI-compatible API (Copilot proxy, LiteLLM, etc.)
OPENAI_BASE_URL=http://127.0.0.1:3030/v1
OPENAI_API_KEY=

# --- Optional: createClaudeModel() / Anthropic-only scripts (not used by resolveAgentChatModel)
# CLAUDE_TRANSPORT=api
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ============================================
# LangSmith (LangGraph dev / traces)
# ============================================

# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=incident-reporter
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com