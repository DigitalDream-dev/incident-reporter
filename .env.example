# How to call Claude: "api" (Anthropic HTTP, default) or "cli" (subprocess: `claude -p ...`).
CLAUDE_TRANSPORT=api

# Required when CLAUDE_TRANSPORT=api
ANTHROPIC_API_KEY=

# Model id (API) or `claude` CLI --model value when CLAUDE_CLI_PASS_MODEL is not false
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- CLI mode (CLAUDE_TRANSPORT=cli) ---
# Executable for Claude Code / headless CLI (default: claude). Must be on PATH.
# CLAUDE_CLI_COMMAND=claude
# JSON array of extra argv inserted before -p, e.g. []
# CLAUDE_CLI_EXTRA_ARGS=[]
# Set to false if your CLI does not support --model (default: true — passes ANTHROPIC_MODEL).
# CLAUDE_CLI_PASS_MODEL=true

# Use built-in mock Notion tools (no MCP subprocess). Set false when using real MCP.
USE_MOCK_NOTION=true

# How to reach MCP servers: JSON map of label → connection (stdio/http/sse).
# Use "env" inside a stdio block for tokens the MCP server expects, not top-level API keys.
# MCP_SERVERS_JSON={"notion":{"transport":"stdio","command":"npx","args":["-y","your-notion-mcp"],"env":{"NOTION_API_KEY":"secret_xxx"}}}
