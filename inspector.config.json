{
  "_profiles": {
    "copilot":   "copilot-extension",
    "claude":    "subprocess",
    "cursor":    "cursor-subprocess"
  },
  "_note": "Set providerMode to a _profiles value. copilot-extension needs OPENAI_BASE_URL + OPENAI_API_KEY in .env; cursor-subprocess uses the cursor block (and optional INSPECTOR_CONFIG_PATH).",

  "providerMode": "copilot-extension",

  "model": "openai:claude-sonnet-4.6",

  "subprocess": {
    "command": "claude",
    "model": "claude-sonnet-4-6",
    "apiKey": "sk-ant-your-anthropic-api-key-here"
  },

  "cursor": {
    "command": "agent",
    "model": "claude-4.6-sonnet",
    "apiKey": "cur_your-cursor-api-key-here"
  }
}
